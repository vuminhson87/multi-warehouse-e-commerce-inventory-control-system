# M3 - Nguyễn Anh Quân: mẫu biến môi trường tầng dữ liệu. Sao chép thành backend/.env rồi chỉnh.
# KHÔNG commit file .env thật.

# PostgreSQL – nguồn sự thật duy nhất của tồn kho/đơn hàng.
DATABASE_URL="postgresql://mw_user:mw_password@localhost:5432/multi_warehouse?schema=public&connection_limit=20"

# Redis – chỉ dùng làm cache đọc, không quyết định reserve (NFR-PER-06).
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED=true
CACHE_TTL_CATALOG_SECONDS=60
CACHE_TTL_INVENTORY_SECONDS=15

# Seed
SEED_DEMO_PASSWORD=123456
SEED_PRODUCT_COUNT=120

# In câu SQL của Prisma ra console khi debug
PRISMA_LOG=false

# Authentication: replace with a random secret in your local .env.
JWT_SECRET=
JWT_EXPIRES_IN=2h
